# GitHub Personal Access Token — used server-side by api/github.js
# Required for fetching latest repository data and contribution activity.
# Do NOT prefix with VITE_, or Vite will bundle it into the public JavaScript.
# Generate one at https://github.com/settings/tokens (read-only access to public repos is enough).
GITHUB_TOKEN=ghp_your_token_here_xxxxxxxxxxxxxxxxxxxx

# Groq API Key — used by the serverless functions in api/chat.js
# Get yours at https://console.groq.com
groq_api_key=Your_groq_key_xxxxxxxxxxxxxxxxx

# AI Assistant URL
# Leave BLANK for Vercel deployment (functions are same-origin at /api)
# Set to http://localhost:3001 only if you want to use the Express server locally
# (Vite's dev proxy already handles this when VITE_AI_SERVER_URL is blank)
VITE_AI_SERVER_URL=

# Allowed origins for the Express server (local dev only, not needed on Vercel)
ALLOWED_ORIGIN=http://localhost:5173