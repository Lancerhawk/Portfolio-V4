    "projects": [
        {
            "label": "Creator of",
            "name": "Rootly-Runtime",
            "slug": "rootly-runtime",
            "tagline": "Surface Production Errors Directly in Your IDE.",
            "description": "Rootly is a developer platform designed to bridge the gap between production failures and your development environment.",
            "longDescription": "Rootly-Runtime bridges the painful gap between production failures and your local development environment. When a user hits an error in production, Rootly instantly surfaces the full stack trace, request context, environment metadata, and affected user session directly inside your IDE — no tab switching, no log hunting.\n\nBuilt as a full-stack developer platform, Rootly consists of a lightweight SDK you drop into any Node.js or Python application, a real-time ingestion API that queues and processes error events at scale, and a VS Code extension that renders everything contextually inside your editor.\n\nThe backend is built with Node.js and Express, using PostgreSQL for persistent error storage with relational schemas optimized for rapid lookups by project, severity, and timestamp. The ingestion pipeline supports batch processing to handle traffic spikes without data loss.",
            "highlights": [
                "Real-time IDE notifications — zero context switching when production breaks",
                "Lightweight SDK with <5ms overhead per request instrumentation",
                "Full stack trace reconstruction with source map support",
                "PostgreSQL-backed storage with relational schema optimized for high-frequency writes",
                "VS Code extension with inline error diffing and quick-fix suggestions",
                "Rate-limited ingestion API to prevent abuse and ensure SLA guarantees",
                "Supports Node.js and Python runtimes out of the box"
            ],
